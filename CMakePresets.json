{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "default",
      "displayName": "Full Windows build",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "RWSMAN_BUILD_GUI": "ON",
        "RWSMAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core, CLI, and tests only (Windows)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {
        "RWSMAN_BUILD_GUI": "OFF",
        "RWSMAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "RWSMAN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Full Linux build",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "RWSMAN_BUILD_GUI": "ON"
      }
    },
    {
      "name": "linux-core",
      "displayName": "Core, CLI, and tests only (Linux)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {
        "RWSMAN_BUILD_GUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "core-debug",
      "configurePreset": "core",
      "configuration": "Debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux",
      "configuration": "Release"
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core",
      "configuration": "Debug"
    },
    {
      "name": "linux-core-release",
      "configurePreset": "linux-core",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-debug",
      "configurePreset": "core",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core-release",
      "configurePreset": "linux-core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
