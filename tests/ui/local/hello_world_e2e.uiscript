# The intro: five shots captured from the view, around the camp and the north.
command mission.cutscene
goto actor:CAMP_TRUCK
click "Intro cutscene::Capture shot from view"
goto actor:OFICIAL
click "Intro cutscene::Capture shot"
goto actor:GE_CAMP
click "Intro cutscene::Capture shot"
goto actor:GE_NORTH
click "Intro cutscene::Capture shot"
goto actor:GE_HOUSE
click "Intro cutscene::Capture shot"
expect timeline.durations 4,4,4,4,4
command file.save
wait idle

# Hello world's structure: 24 actors (2 players, 4 guards, the dog, 7 props
# and the intro's 10 helpers), 2 zones, 5 intro dummies, 16 scripts; one
# navigation group fewer (no start group for the players).
expect count.actors 24
expect count.areas 2
expect count.dummies 5
expect count.scripts 16
expect count.nav_groups 10
expect count.components 11
expect flow.unraised_events 0
expect problems.errors 0
expect problems.warnings 0
expect log.errors 0
expect mission.dirty false
expect project.dirty false

# Saved: reopened, it is the same mission.
remember mission.hash
open $UI_OUTPUT/HelloE2E
wait idle
expect-same mission.hash
expect count.actors 24
expect count.components 11
expect timeline.durations 4,4,4,4,4
