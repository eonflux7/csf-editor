# Script mode (Phase 5, S1-S4): the outline groups scripts, the editor
# completes opcodes and operand tags, and the flow graph marks an event that
# starts scripts but that nothing raises (INIT, once ENTER_YARD is deleted).
open $RWSMAN_UI_FIXTURE/Maps/M1/M1.scn
remember mission.hash
goto script:GUARD_IDLE
expect app.workspace script
expect flow.unraised_events 0

# Tab completes: PAUSE (NUM<Tab> becomes PAUSE (NUMERO.
click Viewport::script_source
key Ctrl+Home
key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down; key Down
key Home
type "    PAUSE (NUM"
key Tab
type " 2.0)"
key Enter
click "Apply (Ctrl+Enter)"
expect-changed mission.hash
expect-contains mission.history.top "script 7"
undo

# Without its sender, INIT starts GUARD_IDLE but never happens.
goto script:ENTER_YARD
click "Delete script"
expect flow.unraised_events 1
undo
expect flow.unraised_events 0
expect-same mission.hash
